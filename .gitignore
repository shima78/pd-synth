# Data and experiment outputs (regenerated by pipeline runs, not checked in).
# Anchored to the repo root so the src/pd_synth/data/ package is still tracked.
/data/
/outputs/*

# ...except the trained mnist_baseline run: the deployed demo app loads these
# checkpoints/metrics at startup, so the generator, the classifier .pt files
# and the .yaml metrics are committed. Everything else in the run dir
# (TensorBoard logs, sample-grid dumps, PNGs, the HTML report) stays ignored.
!/outputs/mnist_baseline/
/outputs/mnist_baseline/*
!/outputs/mnist_baseline/*.yaml
!/outputs/mnist_baseline/*.pt
/outputs/mnist_baseline/sample_grid.pt
!/outputs/mnist_baseline/generator/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
